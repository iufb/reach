<resources>
    <!-- Только окно до старта Compose; сама тема — в ui/theme/Theme.kt -->
    <style name="Theme.Reach" parent="android:Theme.Material.NoActionBar">
        <!-- Системный сплэш Android 12+ (ADR-0012): знак на фоне приложения -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- Android 12: статичный знак. Анимированный при передаче в setOnExitAnimationListener
             пропадает на кадр — сплэш моргает (#341). Анимация «Прорезь» — с Android 13, values-v33 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_reach_mark_circle</item>
    </style>
</resources>
